# JobPilot Environment Configuration
# Copy to ~/.jobpilot/.env and fill in your values.

# ── LLM provider (pick one) ────────────────────────────────────────────
# Recommended: OpenRouter — one key, any model (works with free-tier models).
OPENROUTER_API_KEY=                    # from https://openrouter.ai/keys
LLM_MODEL=google/gemini-2.5-flash-lite # any OpenRouter model slug

# Alternatives
# GEMINI_API_KEY=                      # Google AI Studio (free tier)
# OPENAI_API_KEY=                      # OpenAI
# LLM_URL=http://127.0.0.1:8080/v1     # local llama.cpp/Ollama endpoint

# ── Per-stage LLM routing (optional) ───────────────────────────────────
# Each stage can point at its own gateway/model. Unset stages fall back to
# the provider above. SCORE_*/APPLY_* reuse TAILOR_LLM_API_KEY if they have
# no key of their own, so one gateway credential covers the whole pipeline.
# TAILOR_LLM_URL=https://openrouter.ai/api/v1
# TAILOR_LLM_MODEL=google/gemini-2.5-flash-lite
# TAILOR_LLM_API_KEY=sk-or-v1-...
# SCORE_LLM_MODEL=google/gemini-2.5-flash-lite
# ENRICH_LLM_MODEL=nuextract-2.0-4b      # or a local extractor endpoint
# COVER_LLM_MODEL=google/gemini-2.5-flash-lite
# APPLY_LLM_MODEL=deepseek/deepseek-v4-flash-0731   # long tool-calling loop

# ── Auto-Apply (optional) ──────────────────────────────────────────────
CAPSOLVER_API_KEY=                    # CAPTCHA solving (hCaptcha, reCAPTCHA)

# ── Proxy (optional, for scraping) ─────────────────────────────────────
# PROXY=host:port:user:pass
